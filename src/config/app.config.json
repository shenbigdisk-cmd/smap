{
  "app": {
    "title": "VicPlan WebGIS Framework",
    "subtitle": "Planning Schemes & Spatial Property Information",
    "agency": "State Government of Victoria",
    "defaultTheme": "light",
    "defaultLayout": "application"
  },
  "initialView": {
    "center": [144.9631, -37.8136],
    "zoom": 14.8,
    "pitch": 0,
    "bearing": 0
  },
  "coordinates": {
    "system": "GDA2020",
    "datum": "GDA2020",
    "projection": "MGA2020",
    "defaultZone": 55,
    "transformation": "null",
    "labels": {
      "projected": "MGA2020 Zone 55",
      "geographic": "GDA2020 Geographic",
      "datum": "GDA2020 (GRS80 / Null Transformation)"
    }
  },
  "extentVictoria": {
    "bbox": [
      [140.9617, -39.1592],
      [149.9763, -33.9806]
    ]
  },
  "modules": [
    {
      "id": "workflows",
      "name": "Planning Workflows",
      "shortTitle": "Workflows",
      "description": "Guided statutory property checks, permits and reports",
      "category": "core",
      "enabled": true,
      "pinned": true
    },
    {
      "id": "layers",
      "name": "Map Layers & Opacity",
      "shortTitle": "Layers",
      "description": "Operational layers, symbology legends and transparency",
      "category": "core",
      "enabled": true,
      "pinned": true
    },
    {
      "id": "query",
      "name": "Spatial & Attribute Query",
      "shortTitle": "Query",
      "description": "Search and filter features by SQL attribute rules or drawn geometry",
      "category": "analysis",
      "enabled": true,
      "pinned": true
    },
    {
      "id": "results",
      "name": "Selected Features & Details",
      "shortTitle": "Features",
      "description": "Inspect individual properties or browse and filter multi-record query results",
      "category": "core",
      "enabled": true,
      "pinned": true
    },
    {
      "id": "measure",
      "name": "Spatial Measurement",
      "shortTitle": "Measure",
      "description": "Interactive geodesic distance, polygon area, and coordinates",
      "category": "analysis",
      "enabled": true,
      "pinned": false
    },
    {
      "id": "buffer",
      "name": "Proximity Buffer Analysis",
      "shortTitle": "Buffer",
      "description": "Radial geodesic boundary envelopes around target features",
      "category": "analysis",
      "enabled": true,
      "pinned": false
    },
    {
      "id": "markup",
      "name": "Map Annotations & Markup",
      "shortTitle": "Markup",
      "description": "Draw custom pins, measurement lines, polygons, and text",
      "category": "cartography",
      "enabled": true,
      "pinned": false
    },
    {
      "id": "bookmarks",
      "name": "Spatial Bookmarks",
      "shortTitle": "Bookmarks",
      "description": "Saved viewpoints, capital city extents, and custom views",
      "category": "cartography",
      "enabled": true,
      "pinned": false
    },
    {
      "id": "export",
      "name": "Map & Data Export",
      "shortTitle": "Export",
      "description": "High-resolution map images, PDF prints, and GeoJSON parcels",
      "category": "output",
      "enabled": true,
      "pinned": false
    },
    {
      "id": "toolbox",
      "name": "GIS Toolbox",
      "shortTitle": "Toolbox",
      "description": "Searchable drawer containing all operational GIS utilities",
      "category": "core",
      "enabled": true,
      "pinned": true
    }
  ],
  "search": {
    "sources": [
      {
        "id": "local-cadastre",
        "name": "Property Cadastre (Local)",
        "type": "local-parcels",
        "enabled": true
      },
      {
        "id": "vic-geocoder",
        "name": "Victorian Address Geocoder (ArcGIS REST)",
        "type": "esri-geocoder",
        "url": "https://services.land.vic.gov.au/SpatialDatamart/rest/services/geocoding/GeocodeServer/findAddressCandidates",
        "enabled": false
      }
    ]
  },
  "layers": [
    {
      "id": "layer-parcels",
      "title": "Property Cadastre (Parcels)",
      "category": "cadastre",
      "format": "geojson",
      "type": "line",
      "visible": true,
      "opacity": 0.9,
      "minZoom": 13,
      "color": "#334155",
      "description": "Official property parcel boundaries with Standard Parcel Identifiers (SPI)",
      "operations": [
        "query-attribute",
        "query-spatial",
        "buffer",
        "export",
        "identify",
        "table"
      ],
      "queryConfig": {
        "displayField": "address",
        "outFields": ["address", "spi", "lotPlan", "lga", "areaM2", "zone.code"],
        "fields": [
          { "key": "address", "label": "Property Address", "type": "string" },
          { "key": "spi", "label": "Standard Parcel Identifier (SPI)", "type": "string" },
          { "key": "lotPlan", "label": "Lot / Plan", "type": "string" },
          {
            "key": "lga",
            "label": "Municipality",
            "type": "select",
            "options": ["City of Melbourne", "City of Yarra"]
          },
          { "key": "areaM2", "label": "Land Area (m²)", "type": "number" },
          {
            "key": "zone.code",
            "label": "Planning Zone Code",
            "type": "select",
            "options": ["CCZ1", "C1Z", "GRZ1", "RGZ1", "IN1Z", "PPRZ"]
          }
        ]
      }
    },
    {
      "id": "layer-vic-zones-live",
      "title": "Vic Planning Scheme Zones (Live ArcGIS)",
      "category": "planning",
      "format": "esri-feature",
      "url": "https://spatial.planning.vic.gov.au/gis/rest/services/planning_scheme_zones_vicgrid2020/MapServer/0",
      "type": "fill",
      "visible": false,
      "opacity": 0.65,
      "minZoom": 10,
      "color": "#2563eb",
      "description": "Statewide Victorian statutory planning scheme zones served live via ArcGIS REST MapServer",
      "operations": [
        "query-attribute",
        "query-spatial",
        "export",
        "identify",
        "table"
      ],
      "queryConfig": {
        "displayField": "zone_code",
        "outFields": ["zone_code", "zone_description", "lga", "scheme_code", "zone_code_group_label"],
        "fields": [
          { "key": "zone_code", "label": "Zone Code (e.g. CCZ1, C1Z, GRZ1)", "type": "string" },
          { "key": "zone_description", "label": "Zone Description", "type": "string" },
          { "key": "lga", "label": "Municipality (LGA)", "type": "string" },
          { "key": "scheme_code", "label": "Planning Scheme Code", "type": "string" }
        ]
      }
    },
    {
      "id": "layer-zones",
      "title": "Planning Scheme Zones (Local Cache)",
      "category": "planning",
      "format": "geojson",
      "type": "fill",
      "visible": true,
      "opacity": 0.6,
      "minZoom": 11,
      "color": "#3b82f6",
      "description": "Victorian Planning Scheme statutory zoning (Residential, Commercial, Industrial, Public)",
      "operations": [
        "query-attribute",
        "query-spatial",
        "identify",
        "export",
        "table"
      ],
      "queryConfig": {
        "displayField": "code",
        "outFields": ["code", "name", "category"],
        "fields": [
          { "key": "code", "label": "Zone Code", "type": "string" },
          { "key": "name", "label": "Zone Name", "type": "string" },
          {
            "key": "category",
            "label": "Category",
            "type": "select",
            "options": ["residential", "commercial", "industrial", "public", "rural"]
          }
        ]
      }
    },
    {
      "id": "layer-overlays",
      "title": "Planning Overlays (Heritage / Design / BMO)",
      "category": "overlays",
      "format": "geojson",
      "type": "fill",
      "visible": true,
      "opacity": 0.5,
      "minZoom": 12,
      "color": "#f59e0b",
      "description": "Statutory planning overlays affecting building controls and environmental protections",
      "operations": [
        "query-attribute",
        "query-spatial",
        "identify",
        "export"
      ],
      "queryConfig": {
        "displayField": "code",
        "outFields": ["code", "name", "category"],
        "fields": [
          { "key": "code", "label": "Overlay Code", "type": "string" },
          { "key": "name", "label": "Overlay Name", "type": "string" }
        ]
      }
    },
    {
      "id": "layer-lga",
      "title": "Municipal Boundaries (LGA)",
      "category": "boundaries",
      "format": "geojson",
      "type": "line",
      "visible": true,
      "opacity": 0.8,
      "minZoom": 9,
      "color": "#64748b",
      "description": "Victorian Local Government Area (LGA) council municipal borders",
      "operations": [
        "query-spatial",
        "identify"
      ]
    }
  ],
  "basemaps": [
    {
      "id": "carto-light",
      "name": "Vicmap Cartographic",
      "description": "Clean high-contrast base map for planning scheme legibility",
      "styleUrl": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
      "attribution": "© CARTO, © OpenStreetMap contributors, Vicmap"
    },
    {
      "id": "carto-voyager",
      "name": "Vicmap Standard Color",
      "description": "Full topographic and road hierarchy color palette",
      "styleUrl": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
      "attribution": "© CARTO, © OpenStreetMap contributors"
    },
    {
      "id": "esri-satellite",
      "name": "Aerial Imagery (Satellite)",
      "description": "High-resolution orthophotography",
      "rasterTiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "attribution": "Source: Esri, Maxar, Earthstar Geographics, GIS User Community"
    },
    {
      "id": "carto-dark",
      "name": "Dark Matter",
      "description": "Low-light dark mode base layer",
      "styleUrl": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
      "attribution": "© CARTO, © OpenStreetMap contributors"
    }
  ],
  "defaultBasemapId": "carto-light"
}