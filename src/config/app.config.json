      "layers": [
        {
          "id": "layer-parcels",
          "serviceId": "service-cadastre",
          "title": "Property Cadastre (Parcels)",
          "category": "cadastre",
          "geometryType": "polygon",
          "format": "geojson",
          "type": "line",
          "visible": true,
          "opacity": 0.9,
          "minZoom": 13,
          "color": "#334155",
          "description": "Official property parcel boundaries with Standard Parcel Identifiers (SPI)",
          "operations": ["query-attribute", "query-spatial", "buffer", "export", "identify", "table"],
          "rendering": {
            "format": "geojson",
            "sourceId": "parcels-source",
            "style": {
              "type": "line",
              "paint": {
                "line-color": "#334155",
                "line-width": 1.5
              }
            }
          },
          "data": {
            "adapter": "geojson-client",
            "primaryKey": "id",
            "displayField": "address",
            "outFields": ["address", "spi", "lotPlan", "lga", "areaM2", "zone.code"],
            "fields": [
              { "key": "address", "label": "Property Address", "type": "string" },
              { "key": "spi", "label": "Standard Parcel Identifier (SPI)", "type": "string" },
              { "key": "lotPlan", "label": "Lot / Plan", "type": "string" },
              {
                "key": "lga",
                "label": "Municipality",
                "type": "select",
                "options": ["City of Melbourne", "City of Yarra"]
              },
              { "key": "areaM2", "label": "Land Area (m²)", "type": "number" },
              {
                "key": "zone.code",
                "label": "Planning Zone Code",
                "type": "select",
                "options": ["CCZ1", "C1Z", "GRZ1", "RGZ1", "IN1Z", "PPRZ"]
              }
            ]
          },
          "capabilities": {
            "identify": true,
            "queryAttribute": true,
            "querySpatial": true,
            "buffer": true,
            "export": true,
            "table": true
          }
        }
      ]
